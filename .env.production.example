NODE_ENV=production
APP_ORIGIN=https://shop.example.id
API_BASE_URL=https://api.example.id/api/v1
API_MEDIA_BASE_URL=https://api.example.id
WEB_HOST=127.0.0.1
WEB_PORT=5173
COOKIE_SECURE=true
CSP_MODE=enforce
