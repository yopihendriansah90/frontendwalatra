API_BASE_URL=http://127.0.0.1:8000/api/v1
API_REQUEST_TIMEOUT_MS=15000
SESSION_TTL_SECONDS=43200
SESSION_STORE=memory
# Gunakan redis pada production; kunci harus sama di seluruh instance frontend.
REDIS_URL=redis://127.0.0.1:6379/2
SESSION_ENCRYPTION_KEY=
SESSION_KEY_PREFIX=walatra:web:
# Samakan dengan FRONTEND_BRIDGE_SECRET backend. Jangan masukkan ke config browser.
BACKEND_BRIDGE_SECRET=
# Isi hanya alamat/subnet proxy yang benar-benar dipercaya; kosong untuk koneksi langsung.
TRUSTED_PROXY_IPS=
CSP_MODE=enforce

# Pengaturan web lokal
WEB_HOST=127.0.0.1
WEB_PORT=5173
SEARCH_DEBOUNCE_MS=350

# Pengaturan deployment HTTPS / reverse proxy
# APP_ORIGIN=https://shop.example.id
# COOKIE_SECURE=true
